{
  "name": "devnotes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:popup": "vite build",
    "build:content": "vite build --config vite.content.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "lint": "oxlint src public/serviceWorker.js",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "check:contrast": "node scripts/check-theme-contrast.mjs",
    "build": "npm run typecheck && npm run build:popup && npm run build:content"
  },
  "dependencies": {
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/chrome": "^0.3.7",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.90.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  }
}
